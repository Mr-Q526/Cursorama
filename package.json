{
  "name": "cursorama",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Cursorama 贡献者",
  "description": "Cursorama：自动运镜演示录屏工具",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "package": "npm run build && node node_modules/electron/install.js && node scripts/package.mjs",
    "smoke": "node scripts/build-qa.mjs && electron . --smoke-test"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "studio.cursorama.desktop",
    "productName": "Cursorama",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json", "!node_modules/**/*"],
    "extraResources": [
      { "from": "native", "to": "native" },
      { "from": "third-party", "to": "third-party" },
      { "from": "assets/icon.png", "to": "icon.png" },
      { "from": "node_modules/ffmpeg-static/ffmpeg.exe", "to": "ffmpeg.exe" }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": { "target": "dir", "signExecutable": false, "icon": "assets/icon.ico" },
    "asar": true,
    "npmRebuild": false
  }
}
